              "    pm.expect(body.priority).to.eql(\"MEDIUM\");",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/tickets/\" + body.id);",
              "});",
              "pm.collectionVariables.set(\"progressId\", body.id);"
            ]
          }
        }
      ]
    },
