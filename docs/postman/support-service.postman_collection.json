{
  "info": {
    "name": "Практика: заявки технической поддержки",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Автор: Васильев Юрий, 4П1.23. Запускать целиком по порядку на отдельной пустой учебной базе. Создаёт четыре заявки через API, оставляет их для демонстрации. Повторный запуск останавливается до создания новых данных. Все восемь операций API, статусы 200/201/400/404/409. Инструкция: docs/api-demo.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Категории",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Справочник содержит четыре категории\", () => pm.expect(body.map(x => x.name)).to.have.members([\"Оборудование\", \"Программное обеспечение\", \"Доступы\", \"Сеть\"]));",
              "pm.collectionVariables.set(\"categoryId\", body.find(x => x.name === \"Оборудование\").id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Пустая учебная база",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Перед демонстрацией заявок нет\", () => pm.expect(body.totalElements).to.eql(0));",
              "if (body.totalElements !== 0) {",
              "    pm.execution.setNextRequest(null);",
              "    throw new Error(\"Нужна отдельная пустая учебная база. Существующие заявки не удаляются.\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Новая просроченная заявка",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Не работает принтер\",\n  \"categoryId\": {{categoryId}},\n  \"description\": \"Учебные данные. Васильев Юрий, 4П1.23.\",\n  \"priority\": \"HIGH\",\n  \"dueAt\": \"2000-01-01T00:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Новая заявка и Location\", () => {",
              "    pm.expect(body.status).to.eql(\"NEW\");",
              "    pm.expect(body.closedAt).to.eql(null);",
              "    pm.expect(body.priority).to.eql(\"HIGH\");",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/tickets/\" + body.id);",
              "});",
              "pm.collectionVariables.set(\"newId\", body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Заявка для работы",
