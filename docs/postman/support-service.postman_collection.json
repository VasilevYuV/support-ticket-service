        "url": "{{baseUrl}}/api/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Требуется настройка рабочего места\",\n  \"categoryId\": {{categoryId}},\n  \"description\": \"Учебные данные. Васильев Юрий, 4П1.23.\",\n  \"priority\": \"MEDIUM\",\n  \"dueAt\": null\n}",
          "options": {
            "raw": {
              "language": "json"
