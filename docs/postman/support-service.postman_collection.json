        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Все показатели четырёх заявок\", () => {",
              "    pm.expect(body.totalCreated).to.eql(4);",
              "    pm.expect(body.byStatus).to.eql({NEW: 1, IN_PROGRESS: 1, RESOLVED: 1, CANCELLED: 1});",
              "    pm.expect(body.byPriority).to.eql({LOW: 1, MEDIUM: 2, HIGH: 1});",
              "    pm.expect(body.openOverdue).to.eql(1);",
              "    pm.expect(body.averageResolutionSeconds).to.be.a(\"number\").and.at.least(0);",
              "    const resolved = JSON.parse(pm.collectionVariables.get(\"resolvedSnapshot\"));",
              "    const seconds = (Date.parse(resolved.closedAt) - Date.parse(resolved.createdAt)) / 1000;",
              "    pm.expect(body.averageResolutionSeconds).to.be.closeTo(seconds, 0.001);",
              "});"
            ]
          }
        }
      ]
    },
