              "    pm.expect(body.description).to.eql(\"Проверены питание и кабель. Нужна диагностика.\");",
              "    pm.expect(body.priority).to.eql(\"HIGH\");",
              "    pm.expect(body.dueAt).to.eql(\"2000-01-01T00:00:00Z\");",
              "    pm.expect(body.status).to.eql(\"NEW\");",
              "});"
